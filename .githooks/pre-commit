#!/bin/sh
# Hook de pre-commit. Se activa una sola vez con:
#     git config core.hooksPath .githooks
#
# Las reglas viven en scripts/revisar.mjs (las comparte con el CI de GitHub
# Actions) para que no diverjan entre las dos copias.
#
# Para saltarselo en un caso concreto:  git commit --no-verify

node "$(git rev-parse --show-toplevel)/scripts/revisar.mjs" --staged
