{
  "name": "applet",
  "version": "1.0.0",
  "description": "Sitio web personal de Rubenpantxo, alojado en GitHub Pages bajo el dominio [rubenpantxo.com](https://rubenpantxo.com).",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "npm run biblioteca && npm run css:biblioteca && npm run css:insta",
    "css:insta": "node scripts/css-insta.mjs",
    "test": "node --test \"apps/instagram-downloader/pruebas/*.test.mjs\"",
    "css": "tailwindcss -c tailwind.config.js -i CSS/tailwind.entrada.css -o CSS/tailwind.css --minify",
    "biblioteca": "babel apps/biblioteca/biblioteca.jsx --config-file ./apps/biblioteca/babel.config.cjs -o apps/biblioteca/biblioteca.js",
    "css:biblioteca": "tailwindcss -c tailwind.biblioteca.config.js -i CSS/tailwind.entrada.css -o apps/biblioteca/biblioteca.css --minify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/preset-react": "8.0.1",
    "tailwindcss": "3.4.17"
  }
}
